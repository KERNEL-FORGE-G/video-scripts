# Clés API pour la vidéo UniFlow — lues uniquement par video/build/.
# Modèle : copier ce fichier en `.env` à la racine du dépôt et coller les valeurs
# après le = , sans guillemets. `.env` est ignoré par git, `.env.example` non.
# Rien n'est obligatoire : sans clé, tout le rendu continue de tourner en local.

# --- 1. MEILLEURES SCÈNES (visuels) -------------------------------------
# Google AI Studio. Déjà testée sur ce poste : HTTP 200, accès confirmé à
# gemini-3-pro-image, gemini-3.1-flash-image et gemini-2.5-flash-image.
GEMINI_API_KEY=

# --- 2. MEILLEURS ÉCHANGES (dialogues) ----------------------------------
# Groq : gratuit, très rapide. Sert à faire relire des répliques.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- 3. MEILLEURE ANIMATION 2D (mouvement) ------------------------------
# Kling image→vidéo : 2 ou 3 plans signature seulement.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# --- PASSERELLE (optionnelle) -------------------------------------------
# LaoZhang : une seule clé, accès aux modèles image et vidéo par-dessus les
# fournisseurs ci-dessus. Utile si le quota gratuit Gemini sature.
# https://api2.laozhang.ai/token
LAOZHANG_API_KEY=
# Base OpenAI-compatible par défaut, à ajuster si l'API répond ailleurs.
LAOZHANG_BASE=

# --- FACULTATIF ---------------------------------------------------------
# Hugging Face : quota GPU gratuit testé et déjà épuisé sur ce poste.
HF_TOKEN=
elevenslabs=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_UNI=
ELEVENLABS_VOICE_ARCHLORD=
EDENAI_API_KEY=
DEAPI_API_KEY=
DEAPI_BASE=
